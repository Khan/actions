{
    "name": "static",
    "version": "0.0.1",
    "private": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/Khan/webapp"
    },
    "author": "Khan Academy",
    "scripts": {
        "start": "cd ../webapp && make serve-frontend",
        "stop": "cd ../webapp && make stop",
        "fix-server": "pnpm stop; cd ../webapp && make -C dev/server prune && cd ../frontend; pnpm start",
        "quick-fix-server": "ka-compose exec vitejs pnpm i",
        "deploy-apps": "turbo run deploy --filter='./apps/*' --",
        "linc": "biome lint; pnpm -s run-on-changed-files eslint --ext .js --ext .jsx --ext .ts --ext .tsx --quiet --ignore-path .eslintignore",
        "fixc": "biome lint --write --unsafe; pnpm -s run-on-changed-files eslint --ext .js --ext .jsx --ext .ts --ext .tsx --quiet --ignore-path .eslintignore --fix",
        "tesc": "pnpm -s linc; pnpm -s typecheck; pnpm -s jesc",
        "jesc": "pnpm -s run-on-changed-files pnpm test -- --findRelatedTests --passWithNoTests",
        "changeset": "update-changeset-config && update-catalog-hashes && changeset",
        "lint:pkg-json": "npmPkgJsonLint ./libs",
        "publish:ci": "pnpm -s lint:pkg-json && pnpm -s update-changeset-config && git diff --stat --exit-code HEAD && pnpm -s changeset publish",
        "run-on-changed-files": "git diff -z --name-only --diff-filter=ACMRTUB '@{u}' | tr '\\0' '\\n' | xargs",
        "eslint": "eslint --ext .js --ext .jsx --ext .ts --ext .tsx --quiet --ignore-path .eslintignore",
        "eslint:interactive": "pnpm dlx eslint-interactive@^10 --ext .js --ext .jsx --ext .ts --ext .tsx --quiet --ignore-path .eslintignore",
        "download-introspection-json": "./dev/tools/download-introspection-json.ts",
        "generate-fragment-types": "./dev/tools/generate-fragment-types.ts",
        "lint": "turbo run lint",
        "lint:fix-all": "pnpm -s biome lint --write --unsafe && pnpm -s lint -- --fix",
        "checksync": "pnpm dlx checksync -u",
        "cypress:clean": "test \"${KA_SKIP_GEN}\" && echo 'Skipping Cypress clean...' || rm -rf ./cypress.env.json ./skipped_e2e_tests.json ./.temp-lt-config.json ./.temp-lt-results*.json",
        "cypress:secrets": "test \"${KA_SKIP_GEN}\" && echo 'Skipping Cypress secrets file generation...' || ./dev/cypress/e2e/tools/gen-cypress-secrets.js",
        "cypress": "pnpm -s cypress:clean && pnpm -s cypress:secrets && NODE_TLS_REJECT_UNAUTHORIZED=0 ./dev/cypress/e2e/tools/run-cypress.sh",
        "cypress:dev": "NODE_TLS_REJECT_UNAUTHORIZED=0 pnpm -s cypress run internal",
        "cypress:dev-open": "NODE_TLS_REJECT_UNAUTHORIZED=0 pnpm -s cypress open internal",
        "cypress:open-kadev": "pnpm -s cypress:clean && pnpm -s cypress:secrets && NODE_TLS_REJECT_UNAUTHORIZED=0 ./dev/cypress/e2e/tools/run-cypress-kadev.sh",
        "validate-packages": "update-changeset-config && validate-packages",
        "test:root": "cross-env NODE_OPTIONS=\"--no-deprecation --max_old_space_size=4096\" jest",
        "test:watch:root": "pnpm test:root --watch",
        "test": "cross-env CI=true FORCE_COLOR=true NODE_OPTIONS=\"--no-deprecation\" turbo test test:root",
        "tests": "pnpm -s test --continue -- --passWithNoTests",
        "test:no-console-mock": "cross-env GLOBAL_CONSOLE_MOCK=false pnpm -s test",
        "test:consistency": "cross-env CI=true FORCE_COLOR=true NODE_OPTIONS=\"--no-deprecation\" turbo test:consistency test:consistency:root",
        "test:consistency:root": "jest -u --runInBand consistency-tests",
        "tsc": "cross-env NODE_OPTIONS=\"--max_old_space_size=6144\" tsc",
        "typecheck:root": "pnpm -s tsc --noEmit",
        "typecheck": "turbo typecheck typecheck:root",
        "typewatch": "pnpm -s typecheck:root --incremental --watch",
        "gqlflow": "pnpm -s gqlflow:reset && pnpm -s gqlflow:no-reset",
        "gqlflow:ci": "pnpm -s gqlflow:reset && pnpm -s gqlflow:no-reset && pnpm bump-changed-packages --level patch --pattern __graphql-types__ --message \"Update GraphQL types\"",
        "gqlflow:no-reset": "graphql-flow ./dev/graphql-flow/config.js",
        "gqlflow:reset": "find apps libs -type d -name __graphql-types__ -print0 | xargs -0 rm -rf",
        "gqlflow:dev": "pnpm -s gqlflow --schema-file $(realpath ../webapp/gengraphql/composed_schema.graphql)",
        "gen:ts-component": "pnpm dlx yo ./dev/generators/ts-component",
        "gen:app-features": "growthbook features generate-types --output ./libs/analytics/growthbook/src",
        "build": "turbo run build-app --filter='./apps/*' --",
        "build:stats": "turbo run build-app:stats --filter='./apps/*' --",
        "build:potfile": "pnpm -s i18n:potfile",
        "build:storybook": "cross-env NODE_OPTIONS=--max_old_space_size=20480 storybook build",
        "start:storybook": "storybook dev -p 8228",
        "start:rspack": "nodemon -w libs/config/rspack --exec rspack-dev-server",
        "start:rspack:no-watch": "rspack-dev-server",
        "start:vite": "nodemon -w libs/config/vite --exec vite-dev-server",
        "start:vite:no-watch": "vite-dev-server",
        "i18n:build": "turbo run i18n:build --filter='./apps/*' --",
        "i18n:translate": "turbo run i18n:translate --filter='./apps/*'",
        "i18n:clean": "turbo run i18n:clean --filter='./apps/*' && rm -rf genfiles/i18n/translations",
        "i18n:potfile": "turbo run i18n:potfile --filter='./apps/*' && mkdir -p genfiles/i18n && xgettext apps/*/genfiles/i18n/strings.pot -o genfiles/i18n-lingui.pot",
        "i18n:upload": "i18n-upload",
        "i18n:extract-external-strings": "turbo run i18n:extract-external-strings --filter='./libs/**'",
        "i18n:download": "i18n-download-strings",
        "build:gerald-reviewer": "./dev/tools/build-gerald-reviewer.ts",
        "fix-workflows": "./dev/tools/fix-workflows.ts",
        "upload:sentry-ownership": "./dev/tools/build-upload-sentry-ownership.ts",
        "create-graphql-gateway-config": "create-graphql-gateway-config",
        "auth": "./dev/tools/auth-github-packages.mjs",
        "pnpm:devPreinstall": "pnpm -s auth -v || (echo \"Please run 'pnpm auth' to authenticate with GitHub Packages before running 'pnpm install'.\" && exit 1)",
        "force-update": "touch package.json && pnpm i",
        "fi": "pnpm force-update",
        "update:gql": "pnpm download-introspection-json && pnpm generate-fragment-types && pnpm gqlflow:ci",
        "update:all": "pnpm fi && update-workspace-deps && pnpm build:gerald-reviewer && update-changeset-config && lint-changesets --fix && update-catalog-hashes && validate-packages --fix && pnpm checksync",
        "update-event-schemas": "update-catalog-ref --latest=tag @khanacademy/event-schemas"
    },
